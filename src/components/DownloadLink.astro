---
interface Props { href: string; label: string; }
const { href, label } = Astro.props;
---
<a class="download-link eyebrow" href={href} download>{label}<svg class="link-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0 3-3m-3 3L5 7M3 12.5h10" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
<style>
a {display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:36px;font-size:16px;text-align:center;transition:color 200ms ease;}
svg {width:16px;height:16px;flex:none;transition:transform 200ms ease;}
a:hover {color:#94742c;} a:hover svg {transform:translateY(3px);}
@media(prefers-reduced-motion:reduce){a,svg{transition:none;}}
</style>
