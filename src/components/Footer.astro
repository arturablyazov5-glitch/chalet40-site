---
import { t, localizedPath, unlocalizedPath, type Locale } from "../i18n";
import { siteData } from "../data/site";
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const path = unlocalizedPath(Astro.url.pathname);
const contact =
  unlocalizedPath(Astro.url.pathname).replace(/\/$/, "") === "/contact";
const SalesHeading = contact ? "h1" : "h2";
const notice = t(lang, "footer.notice").split("наш.дом.рф");
---

<footer
  id="footer-contact"
  class="site-footer"
>
  <div class="footer-content">
    <div class="footer-sales">
      <SalesHeading>{t(lang, "footer.sales")}:</SalesHeading>
      <div>
        <a href={siteData.contacts.emailHref}>{siteData.contacts.email}</a>
        <a href={siteData.contacts.phoneHref}>{siteData.contacts.phone}</a>
      </div>
      <p>{t(lang, "footer.address")}</p>
      <div class="footer-links">
        {siteData.footerLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener">
            {t(lang, link.key)}
          </a>
        ))}
      </div>
    </div>
    <div class="footer-partners">
      <a href="https://hitdev.ru/" target="_blank" rel="noopener">
        <img
          src="/assets/brand/developer.svg"
          alt="Hitech development — искусство недвижимости"
          width="226"
          height="75"
          loading="lazy"
          decoding="async"
        />
        <p class="footer-partner-tagline">{t(lang, "footer.tagline")}</p>
      </a>
      <img
        src="/assets/brand/architect.svg"
        alt="Ginzburg Architects"
        width="226"
        height="80"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="footer-form">
      <h2>{t(lang, "ui.consult")}</h2>
      <form
        data-consult-form
        action="/api/consult"
        method="post"
        data-success={t(lang, "form.success")}
        data-error={t(lang, "form.error")}
        data-invalid={t(lang, "form.invalid")}
        data-rate={t(lang, "form.rate")}
        data-unavailable={t(lang, "form.unavailable")}
        data-sending={t(lang, "form.sending")}
        data-unknown={t(lang, "form.deliveryUnknown")}
      >
        <label class="sr-only" for="footer-name">
          {t(lang, "form.name")}
        </label>
        <input
          id="footer-name"
          name="name"
          autocomplete="name"
          minlength="2"
          maxlength="100"
          required
          placeholder={t(lang, "footer.namePlaceholder")}
        />
        <input type="hidden" name="method" value="phone" />
        <label class="sr-only" for="footer-phone">
          {t(lang, "form.contact")}
        </label>
        <input
          id="footer-phone"
          name="contact"
          type="tel"
          autocomplete="tel"
          minlength="3"
          maxlength="100"
          required
          placeholder="+7 000 000-00-00"
        />
        <div class="honeypot" aria-hidden="true">
          <label>
            {t(lang, "form.company")}
            <input name="company" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <label class="footer-consent">
          <input type="checkbox" name="consent" required checked />
          <span>
            {t(lang, "form.consent")}{" "}
            <a href={localizedPath("/privacy", lang)}>
              {t(lang, "form.privacy")}
            </a>
          </span>
        </label>
        <button type="submit">{t(lang, "footer.submit")}</button>
        <p
          class="form-notice"
          role="status"
          aria-live="polite"
          tabindex="-1"
        ></p>
      </form>
    </div>
    <p class="footer-legal">
      {notice[0]}<a href="https://наш.дом.рф/сервисы/каталог-новостроек/объект/71477" target="_blank" rel="noopener">наш.дом.рф</a>{notice[1]}
      <span class="footer-languages">
        <a href={localizedPath(path.replace(/\/$/, "") || "/", "ru")} lang="ru">
          RU
        </a>{" "}
        /{" "}
        <a href={localizedPath(path.replace(/\/$/, "") || "/", "en")} lang="en">
          EN
        </a>
      </span>
    </p>
  </div>
</footer>

