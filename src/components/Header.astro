---
import { t, localizedPath, unlocalizedPath, type Locale } from "../i18n";
import { siteData } from "../data/site";
import ConsultButton from "./ConsultButton.astro";
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const path = unlocalizedPath(Astro.url.pathname).replace(/\/$/, "") || "/";

const other = lang === "ru" ? "en" : "ru";
---

<header class:list={["site-header", { "site-header-home": true }]}>
  <button
    type="button"
    class="menu-trigger"
    data-open-menu
    aria-controls="site-navigation"
    aria-expanded="false"
    aria-label={t(lang, "nav.menu")}
  >
    <img
      src="/assets/brand/menu-burger.svg"
      width="38"
      height="38"
      alt=""
      loading="eager"
      decoding="async"
    />
  </button>
  {path !== "/map" && <>
    <a
      class="header-identity"
      href={localizedPath("/", lang)}
      aria-label={t(lang, "nav.home")}
    >
      
        <img
          class="header-address"
          src="/assets/brand/home-address.svg"
          alt={t(lang, "header.address")}
          width="302"
          height="16"
          loading="eager"
          decoding="async"
        />
      
    </a>
    <a
      class="header-language"
      href={localizedPath(path, other)}
      lang={other}
      aria-label={t(lang, "nav.language")}
    >
      {other.toUpperCase()}
    </a>
  </>}
</header>
<dialog
  id="site-navigation"
  class="navigation-dialog"
  aria-label={t(lang, "nav.menu")}
>
  <button
    class="navigation-close"
    type="button"
    data-close-menu
    aria-label={t(lang, "ui.close")}
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path
        d="m3 3 18 18M21 3 3 21"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
    </svg>
  </button>
  <nav aria-label={t(lang, "nav.menu")}>
    {siteData.menu.map(({ key, href }) => (
      <a href={localizedPath(href, lang)} aria-current={path === href ? "page" : undefined}>{t(lang, key)}</a>
    ))}
  </nav>
  <div class="navigation-bottom">
    <div class="navigation-languages">
      <a href={localizedPath(path, "ru")} lang="ru">
        RU
      </a>{" "}
      /{" "}
      <a href={localizedPath(path, "en")} lang="en">
        EN
      </a>
    </div>
    <div class="navigation-contacts">
      <b>{t(lang, "footer.sales")}:</b>
      <a href={siteData.contacts.emailHref}>{siteData.contacts.email}</a>
      <a href={siteData.contacts.phoneHref}>{siteData.contacts.phone}</a>
    </div>
    <div class="navigation-social">
      <a href={siteData.contacts.phoneHref} aria-label={t(lang, "form.phone")}>
        <img
          src="/assets/brand/phone.svg"
          width="30"
          height="30"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </a>
      <a
        href="https://wa.me/74952259501"
        aria-label="WhatsApp"
        target="_blank"
        rel="noopener"
      >
        <img
          src="/assets/brand/whatsapp.svg"
          width="30"
          height="30"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
    <ConsultButton lang={lang} label={t(lang, "header.consult")} />
  </div>
</dialog>
<noscript>
  <details class="nojs-navigation">
    <summary>{t(lang, "nav.menu")}</summary>
    {siteData.menu.map(({ key, href }) => (
      <a href={localizedPath(href, lang)} aria-current={path === href ? "page" : undefined}>{t(lang, key)}</a>
    ))}
  </details>
</noscript>
<script>
  const menu = document.querySelector<HTMLDialogElement>("#site-navigation");
  const trigger = document.querySelector<HTMLButtonElement>("[data-open-menu]");
  if (menu && trigger) {
    const closeMenu = () => {
      if (!menu.open || menu.classList.contains("is-closing")) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        menu.close();
        return;
      }
      menu.classList.add("is-closing");
      window.setTimeout(() => {
        menu.close();
        menu.classList.remove("is-closing");
      }, 300);
    };
    trigger.addEventListener("click", () => {
      menu.showModal();
      trigger.setAttribute("aria-expanded", "true");
    });
    menu
      .querySelector("[data-close-menu]")
      ?.addEventListener("click", closeMenu);
    menu.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeMenu();
    });
    menu.addEventListener("click", (event) => {
      if (event.target === menu) {
        const box = menu.getBoundingClientRect();
        if (event.clientX > box.right || event.clientX < box.left) closeMenu();
      }
    });
    menu.addEventListener("close", () =>
      trigger.setAttribute("aria-expanded", "false"),
    );
    menu.querySelector("[data-consult]")?.addEventListener("click", () => {
      menu.close();
    });
  }
</script>
