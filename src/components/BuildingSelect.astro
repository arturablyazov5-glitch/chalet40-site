---
import hitRegions from "../data/render-regions.json";
import componentStyles from "./BuildingSelect.css?url";
import {
  getLots,
  buildings,
  buildingPath,
  lotPath,
  lotText,
  priceText,
  lotMetrics,
  type Building,
  type Lot,
} from "../lib/lots";
import { lotSeo, lotJsonLd } from "../lib/seo";
import { t, localizedPath, currency, number, type Locale } from "../i18n";
import LotImage from "./LotImage.astro";
interface Props {
  building: Building;
  lang: Locale;
}
const { building, lang } = Astro.props;
const lots = getLots(building);
const first = lots[0]!;
const specOrder = ["floor", "ceiling", "terrace", "roofTerrace"] as const;
const specMetrics = (lot: Lot) =>
  specOrder
    .map((key) => lotMetrics(lot, lang).find((m) => m.key === key))
    .filter((m) => m !== undefined);
const selection = lots.map((lot) => ({
  id: lot.id,
  path: localizedPath(lotPath(lot), lang),
  name: lotText(lot, lang).name,
  areaText: number(lang, lot.area),
  bodyDescription: lotText(lot, lang).description,
  specs: specMetrics(lot),
  statusText: t(lang, `ui.${lot.status}`),
  rateText:
    lot.status === "available" && lot.pricePerSqm
      ? `${currency(lang, lot.pricePerSqm)} ${t(lang, "ui.perArea")}`
      : "",
  totalText: lot.status === "available" ? priceText(lot, lang) : "",
  ...lotSeo(lot, lang),
  jsonLd: lotJsonLd(lot, lang),
}));
const initial = selection[0]!;
const usesPyatnitskayaRender = building === "pyatnitskaya" || building === "retail";
const interactiveRegions = hitRegions;

---
<link rel="stylesheet" href={componentStyles} />

<section
  class="building-select"
  data-select
  data-building-path={localizedPath(buildingPath(building), lang)}
  data-initial-lot={first.id}
>
  {usesPyatnitskayaRender ? (
    <div class="selection-background">
      <img src="/assets/buildings/pyatnitskaya-day.webp" width="5079" height="3677" alt={t(lang, `building.${building}`)} loading="eager" />
      <svg class="selection-hit-map" viewBox="0 0 5079 3677" preserveAspectRatio="xMidYMid slice" aria-label={t(lang,"ui.select")}>
        <defs><mask id="lot-spotlight" maskUnits="userSpaceOnUse" x="0" y="0" width="5079" height="3677"><rect width="5079" height="3677" fill="white"/><path data-spotlight-hole d={hitRegions.find(region=>region.id===first.id)?.d} fill="black"/></mask></defs>
        <rect class="selection-dimmer" width="5079" height="3677" fill="black" mask="url(#lot-spotlight)" />
        {interactiveRegions.map(region => { const target= getLots().find(l=>l.id===region.id)!;const own=target.building===building;const zoneName=t(lang,`building.${target.building}`);return <a href={localizedPath(own?lotPath(target):buildingPath(target.building),lang)} {...(own?{"data-select-lot":target.id}:{"data-hit-zone":target.building})} aria-label={own?lotText(target,lang).name:zoneName} data-hit-id={target.id} data-hit-name={own?`${lotText(target,lang).name} · ${number(lang,target.area)} ${t(lang,"ui.sqm")}`:zoneName}><path d={region.d}/></a>; })}
      </svg>
      <span class="map-tooltip" role="tooltip" data-render-tooltip hidden></span>
    </div>
  ) : lots.map((lot, i) => (
    <div class="selection-background" data-slide={lot.id} hidden={i !== 0}>
      <LotImage
        src={lot.media.hero.src}
        alt={t(lang, `lot.${lot.id}.alt.hero`)}
        eager={i === 0}
        hero
      />
    </div>
  ))}
  <div class="selection-inner">
    <nav class="building-nav" aria-label={t(lang, "ui.select")}>
      {buildings
        .map((b) => (
          <a
            href={localizedPath(buildingPath(b), lang)}
            class:list={{ "building-switch": b !== "retail" }}
            aria-current={b === building ? "page" : undefined}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {b === "retail" ? <><path d="M4 10v10h16V10M3 10l2-6h14l2 6M3 10c0 3 4 3 4 0 0 3 5 3 5 0 0 3 5 3 5 0 0 3 4 3 4 0M9 20v-6h6v6"/></> : <><path d="M5 21V3h14v18M3 21h18M9 21v-5h6v5M9 7h1m4 0h1M9 11h1m4 0h1"/></>}
            </svg>
            {b === "retail"
              ? t(lang, "nav.retail")
              : t(lang, `building.${b}`)}
          </a>
        ))}
      <a href={localizedPath("/parking", lang)}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M10 17V7h3a3 3 0 0 1 0 6h-3"/></svg>{t(lang, "nav.parking")}</a>
    </nav>
    <div class="selection-main">
      <div class="selection-heading">
        <h1 data-select-heading>{initial.name}</h1>
        <p class="lot-status" data-select-status>{t(lang, `ui.${first.status}`)}</p>
        <dl class="metrics"><div class="metric"><dt class="metric-label">{t(lang,"metric.area")}</dt><dd class="metric-value"><span data-select-area data-count-value>{initial.areaText}</span><span class="metric-unit">{t(lang,"ui.sqm")}</span></dd></div></dl>
        <dl class="lot-specs" data-select-specs>
          {specMetrics(first).map((m) => (
            <div class="metric">
              <dt class="metric-label">{m!.label}</dt>
              <dd class="metric-value">
                <span>{m!.value}</span>
                {m!.unit ? <span class="metric-unit">{m!.unit}</span> : null}
              </dd>
            </div>
          ))}
        </dl>
        <p data-select-description>{initial.bodyDescription}</p>
      </div>
      <div class="selection-bottom">
        <div class="selection-bottom-left">

          <div class:list={{ "selection-actions": true, "selection-actions--single": lots.length <= 1 }}>
            <a class="selection-plan button button-gold" href={initial.path} data-select-plan>
              {t(lang, "select.plan")}
            </a>
            {lots.length > 1 && (
              <div class="other-rooms">
                <p>{t(lang, "select.others")}</p>
                <nav class="lot-buttons" aria-label={t(lang, "select.others")}>
                  {lots.map((lot, i) => (
                    <a
                      href={localizedPath(lotPath(lot), lang)}
                      data-select-lot={lot.id}
                      aria-current={i === 0 ? "true" : undefined}
                    >
                      <span>{lotText(lot, lang).name}</span><small><span data-count-value>{number(lang,lot.area)}</span> {t(lang,"ui.sqm")}</small>
                    </a>
                  ))}
                </nav>
              </div>
            )}
          </div>
        </div>
        <div class="selection-price" hidden={!initial.rateText}>
          <p class="price-primary" data-select-rate>{initial.rateText}</p>
          <p class="price-total" data-select-total>{initial.totalText}</p>
        </div>
      </div>
    </div>
  </div>
  <script
    type="application/json"
    data-selection
    set:html={JSON.stringify(selection).replace(/</g, "\\u003c")}
  />
</section>

<script>
document.querySelectorAll<HTMLElement>('.selection-background').forEach(slide=>{
 const tooltip=slide.querySelector<HTMLElement>('[data-render-tooltip]');
 const hole=slide.querySelector<SVGPathElement>('[data-spotlight-hole]');
 if(!hole) return;
 const select=slide.closest<HTMLElement>('[data-select]');
 const currentPath=()=>{const id=document.body.dataset.lot||select?.dataset.initialLot;const link=slide.querySelector(`[data-select-lot="${id}"]`);return link?.querySelector('path')?.getAttribute('d')??'';};
 const restore=()=>{hole.setAttribute('d',currentPath());};
 slide.querySelectorAll<SVGAElement>('[data-hit-name]').forEach(link=>{
 const hide=()=>{if(tooltip) tooltip.hidden=true;restore()};
 link.addEventListener('pointerenter',()=>{
  const zone=link.dataset.hitZone;
  if(zone){const zoneLinks=[...slide.querySelectorAll<SVGAElement>(`[data-hit-zone="${zone}"]`)];zoneLinks.forEach(z=>z.classList.add('is-zone-hover'));if(hole)hole.setAttribute('d',zoneLinks.map(z=>z.querySelector('path')?.getAttribute('d')??'').join(' '));}
  else{const path=link.querySelector('path');if(hole && path) hole.setAttribute('d',path.getAttribute('d')??'');}
  if(tooltip && !matchMedia('(prefers-reduced-motion: reduce)').matches) tooltip.animate([{opacity:0},{opacity:1}],{duration:160,easing:'ease-out'});});
 link.addEventListener('pointermove',event=>{if(!tooltip)return;const rect=slide.getBoundingClientRect();tooltip.textContent=link.dataset.hitName??'';tooltip.hidden=false;tooltip.style.left=`${Math.min(rect.width-90,Math.max(50,event.clientX-rect.left))}px`;tooltip.style.top=`${event.clientY-rect.top-48}px`;});
 link.addEventListener('pointerleave',()=>{const zone=link.dataset.hitZone;if(zone)slide.querySelectorAll<SVGAElement>(`[data-hit-zone="${zone}"]`).forEach(z=>z.classList.remove('is-zone-hover'));hide();});link.addEventListener('click',hide);
 });
});
</script>
