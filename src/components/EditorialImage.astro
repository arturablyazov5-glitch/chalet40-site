---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
  hero?: boolean;
  highResolution?: boolean;
}
const {
  src,
  alt,
  eager = false,
  hero = false,
  highResolution = false,
} = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/editorial/*.{png,jpg,webp,svg}",
  { eager: true },
);
const image = files[`../assets/${src}`]?.default;
if (!image) throw new Error(`Missing editorial image ${src}`);
---

{src.endsWith(".svg") ? (
  <img
    src={image.src}
    alt={alt}
    width={image.width}
    height={image.height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
) : (
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={
      highResolution
        ? [640, 1024, 1600, 2400, 3200, 4000, 4646]
        : hero
          ? [640, 1024, 1600]
          : [320, 640, 1000]
    }
    quality={highResolution ? 90 : undefined}
    sizes={
      hero
        ? "100vw"
        : "(max-width:767px) 100vw, 60vw"
    }
    loading={eager ? "eager" : "lazy"}
  />
)}
