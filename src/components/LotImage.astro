---
import { Picture } from "astro:assets";
import { mediaSource } from "../lib/media";
interface Props {
  src: string;
  alt: string;
  eager?: boolean;
  hero?: boolean;
}
const { src, alt, eager = false, hero = false } = Astro.props;
const image = mediaSource(src);
---

{(src.endsWith(".svg") || hero) ? (
  <img
    src={image.src}
    alt={alt}
    width={image.width}
    height={image.height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
) : (
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={hero ? [640, 1024, 1600] : [320, 640, 1000]}
    sizes={
      hero
        ? "100vw"
        : "(max-width: 767px) 48vw, 50vw"
    }
    loading={eager ? "eager" : "lazy"}
  />
)}
